generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// USUÁRIOS DA PLATAFORMA
// ==========================================
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relacionamentos
  wabaAccounts WabaAccount[]
  messages     Message[]

  @@map("users")
}

enum Role {
  ADMIN
  USER
}

// ==========================================
// CONTAS WABA (WhatsApp Business Account)
// Vinculadas via Embedded Signup
// ==========================================
model WabaAccount {
  id              String   @id @default(uuid())
  userId          String
  wabaId          String   @unique
  phoneNumberId   String   @unique
  phoneNumber     String?
  displayName     String
  accessToken     String   // token de acesso permanente
  webhookVerified Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relacionamentos
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts    Contact[]
  messages    Message[]
  templates   Template[]
  crmCustomers CrmCustomer[]
  campaigns   Campaign[]

  @@map("waba_accounts")
}

// ==========================================
// CONTATOS
// ==========================================
model Contact {
  id            String   @id @default(uuid())
  wabaAccountId String
  phone         String
  name          String?
  email         String?
  tags          String[]
  isBlocked     Boolean  @default(false)
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relacionamentos
  wabaAccount WabaAccount @relation(fields: [wabaAccountId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([wabaAccountId, phone])
  @@map("contacts")
}

// ==========================================
// MENSAGENS
// ==========================================
model Message {
  id              String        @id @default(uuid())
  wabaAccountId   String
  contactId       String
  userId          String?       // quem enviou (null se recebida)
  waMessageId     String?       @unique // ID retornado pela Meta
  direction       Direction
  type            MessageType
  status          MessageStatus @default(PENDING)
  content         Json          // conteúdo flexível (texto, mídia, template, etc.)
  errorMessage    String?
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relacionamentos
  wabaAccount WabaAccount @relation(fields: [wabaAccountId], references: [id])
  contact     Contact     @relation(fields: [contactId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@map("messages")
}

enum Direction {
  INBOUND   // recebida do cliente
  OUTBOUND  // enviada pela plataforma
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
  INTERACTIVE
  REACTION
  LOCATION
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ==========================================
// TEMPLATES
// ==========================================
model Template {
  id              String         @id @default(uuid())
  wabaAccountId   String
  metaTemplateId  String?
  name            String
  category        String
  language        String         @default("pt_BR")
  status          TemplateStatus @default(PENDING)
  components      Json           // estrutura dos componentes Meta
  bodyText        String?        // espelho de components[BODY].text - corpo com {{1}}, {{2}} etc.
  variableCount   Int            @default(0) // quantas variáveis posicionais o corpo tem
  rejectedReason  String?        // motivo devolvido pela Meta quando REJECTED
  costPerConversation Float?     // custo cobrado pela Meta por conversa iniciada (ex: 0.33)
  linkUrl         String?        // destino final do link rastreado (token link_rastreado)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relacionamentos
  wabaAccount WabaAccount @relation(fields: [wabaAccountId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]

  @@unique([wabaAccountId, name])
  @@map("templates")
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

// ==========================================
// CRM - CLIENTES DO RESTAURANTE
// ==========================================
model CrmCustomer {
  id              String    @id @default(uuid())
  wabaAccountId   String
  phone           String
  name            String?
  email           String?
  totalOrders     Int       @default(0)
  totalSpent      Float     @default(0)
  averageTicket   Float     @default(0)
  lastOrderAt     DateTime?
  firstOrderAt    DateTime?
  daysSinceOrder  Int       @default(0)
  favoriteItems   Json      @default("[]")
  tags            String[]
  source          String    @default("manual") // manual, multipedidos, anotaai, etc.
  externalId      String?   // ID no sistema de origem
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relacionamentos
  wabaAccount         WabaAccount         @relation(fields: [wabaAccountId], references: [id], onDelete: Cascade)
  campaignExecutions  CampaignExecution[]
  orders              CustomerOrder[]

  @@unique([wabaAccountId, phone])
  @@map("crm_customers")
}

// ==========================================
// HISTÓRICO DE PEDIDOS
// ==========================================
model CustomerOrder {
  id            String      @id @default(uuid())
  crmCustomerId String
  wabaAccountId String
  externalId    String?     // ID do pedido no Multipedidos
  total         Float       @default(0)
  items         Json        @default("[]") // [{ name, quantity, price }]
  source        String      @default("multipedidos")
  orderedAt     DateTime    @default(now())
  createdAt     DateTime    @default(now())

  crmCustomer   CrmCustomer @relation(fields: [crmCustomerId], references: [id], onDelete: Cascade)

  @@map("customer_orders")
}

// ==========================================
// CAMPANHAS
// ==========================================
model Campaign {
  id              String         @id @default(uuid())
  wabaAccountId   String
  name            String
  message         String         // corpo renderizado (referência/histórico). Com template, espelha o bodyText.
  templateId      String?        // template aprovado usado no disparo (obrigatório para envio em massa)
  templateParams  Json           @default("[]") // tokens por posicao: ["nome","dias_sem_comprar"] alimenta {{1}},{{2}}
  segmentFilter   Json           // filtros: { daysInactive, minOrders, maxOrders, minTicket, favoriteItem, tags }
  sourceFilter    String?        // restringe o disparo a uma origem de contatos (ex: multipedidos, fidelidade_10x)
  status          CampaignStatus @default(DRAFT)
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  deliveredCount  Int            @default(0)
  readCount       Int            @default(0) // alimentado pelo webhook (status "read")
  clickCount      Int            @default(0) // alimentado pela rota de rastreamento /api/campaigns/r/:id
  failedCount     Int            @default(0)
  estimatedCost   Float?         // totalRecipients x costPerConversation, gravado no disparo
  totalCost       Float?         // sentCount x costPerConversation, gravado ao concluir
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relacionamentos
  wabaAccount WabaAccount         @relation(fields: [wabaAccountId], references: [id], onDelete: Cascade)
  template    Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  executions  CampaignExecution[]

  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  RUNNING
  COMPLETED
  PAUSED
  FAILED
}

// ==========================================
// EXECUÇÃO DE CAMPANHAS (por cliente)
// ==========================================
model CampaignExecution {
  id            String          @id @default(uuid())
  campaignId    String
  crmCustomerId String
  status        ExecutionStatus @default(PENDING)
  message       String          // mensagem final com variáveis substituídas
  waMessageId   String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?       // preenchido pelo webhook quando a Meta reporta "read"
  clicked       Boolean         @default(false)
  failedReason  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relacionamentos
  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  crmCustomer CrmCustomer @relation(fields: [crmCustomerId], references: [id], onDelete: Cascade)

  // O webhook busca a execução por waMessageId a cada status recebido
  @@index([waMessageId])
  @@map("campaign_executions")
}

enum ExecutionStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}
